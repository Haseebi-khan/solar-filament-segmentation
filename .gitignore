# Python environments
.venv/
.venv-tools/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Competition data and downloads (CC BY-NC 4.0, re-downloadable from Kaggle)
data/
external/
*.zip

# Bulky regenerable artefacts: decoded image cache (~6 GB) and probability maps (~15 GB)
work/cache/
work/preds/
*.npy
*.npz
*.parquet

# Tracked results: model weights (work/models, via Git LFS, see .gitattributes),
# rescorers (work/rescorers), training logs, submissions/*.csv, final scores (logs/final_*.txt).
# Raw stdout of runs is noisy (warnings) and duplicated in work/models/*/fold*.log:
logs/*
!logs/final_*.txt
!logs/ablations.txt

# Credentials (the Kaggle token lives in ~/.kaggle, never in the repo)
kaggle.json
access_token
.env

# Editor / OS
.vscode/
.idea/
.DS_Store

# v3: resume checkpoints (model + EMA + optimiser, several GB) and bulky / regenerable artefacts
work/models/*/*_last.pt
work/pools_v3/
work/linker_v3/
work/ablations_v3/
work/models/abl_*/
work/unlabeled/
# v3 budget members: checkpoints are 240-390 MB (GitHub limit 100 MB, no Git LFS here); released separately
work/models/m4_vitb_1536_v3/*.pt
work/models/m5_cnxs_1536_v3/*.pt

# Reproduction run of the submission package and release assets (regenerable / uploaded separately)
work_reproduce/
release_v3/

# Local working notes (not part of the submission)
HANDOFF_V3.md
